<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.SetmealDishMapper">
    <select id="getSetmealIdsByDishId" resultType="java.lang.Long">
        select setmeal_id from setmeal_dish where dish_id in
        <foreach collection="dishIds" item="dishId" separator="," open="(" close=")">
            #{dishId}
        </foreach>
    </select>
    <select id="getByIdWithDish" resultType="com.sky.entity.SetmealDish">
        select * from setmeal_dish where setmeal_id = #{id}
    </select>
    <insert id="insertBatch" parameterType="list">
        insert into setmeal_dish(setmeal_id,dish_id, name, price, copies)
        VALUES
            <foreach collection="setmealDishes" item="st" separator=",">
                (#{st.setmealId},#{st.dishId},#{st.name},#{st.price},#{st.copies})
            </foreach>
    </insert>
    <delete id="deleteBatchBySetmealIds">
        delete from setmeal_dish where setmeal_id in
        <foreach collection="ids" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
    </delete>
</mapper>
